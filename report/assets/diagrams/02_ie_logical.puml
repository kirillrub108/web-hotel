@startuml
!include _style.iuml
hide circle
skinparam linetype ortho
skinparam defaultFontSize 12
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam nodesep 40
skinparam ranksep 50
entity "Гостиница" as hotels {
  * Код гостиницы <<PK>>
  --
  * Название
  * Слоган
  * Описание
  * Адрес
  * Телефон
  * Электронная почта
  * Время заезда
  * Время выезда
}
entity "Номер" as rooms {
  * Код номера <<PK>>
  --
  * Адрес страницы <<AK>>
  * Название
  * Описание
  * Цена за ночь
  * Вместимость
  * Площадь
  * Удобства
  * Изображение
  * Доступность
}
entity "Пользователь" as users {
  * Код пользователя <<PK>>
  --
  * Электронная почта <<AK>>
  * Хэш пароля
  * ФИО
    Телефон
  * Роль
  * Статус клиента
    Заметка администратора
  * Активность
    Подтверждение почты
  * Согласие на обработку ПДн
  * Дата регистрации
    Последний вход
}
entity "Бронирование" as bookings {
  * Код брони <<PK>>
  --
  * Код номера <<FK>>
  * Код пользователя <<FK>>
  * Имя гостя
  * Телефон
  * Дата заезда
  * Дата выезда
  * Количество гостей
    Комментарий
  * Статус
    Автор решения
  * Коды причин
    Пояснение
  * Количество ночей
  * Цена за ночь
  * Скидка
  * Итоговая стоимость
    Код акции <<FK>>
    Кто отменил
    Дата отмены
  * Дата создания
}
entity "Событие брони" as booking_events {
  * Код события <<PK>>
  --
  * Код брони <<FK>>
    Исходный статус
  * Новый статус
  * Инициатор
    Код пользователя <<FK>>
  * Коды причин
    Пояснение
  * Время события
}
entity "Акция" as promos {
  * Код акции <<PK>>
  --
  * Промокод <<AK>>
  * Название
  * Описание
  * Вид скидки
  * Размер скидки
  * Начало действия
  * Окончание действия
  * Минимум ночей
    Код номера <<FK>>
    Код пользователя <<FK>>
  * Активность
  * Дата создания
}
entity "Услуга" as services {
  * Код услуги <<PK>>
  --
  * Символьный код <<AK>>
  * Название
  * Описание
  * Категория
  * Цена
  * Единица цены
  * Активность
  * Порядок
}
entity "Заказ услуги" as service_orders {
  * Код заказа <<PK>>
  --
  * Код брони <<FK>>
  * Код услуги <<FK>>
  * Количество
  * Цена за единицу
  * Сумма
  * Время исполнения
    Комментарий
  * Статус
  * Дата создания
}
entity "Уборка" as housekeeping_tasks {
  * Код уборки <<PK>>
  --
  * Код брони <<FK>>
  * Код номера <<FK>>
  * Дата
  * Вид уборки
  * Время уборки
  * Статус
    Время выполнения
}
entity "Сессия" as sessions {
  * Код сессии <<PK>>
  --
  * Код пользователя <<FK>>
  * Хэш токена <<AK>>
  * Время создания
  * Срок действия
}
entity "Токен почты" as email_tokens {
  * Код токена <<PK>>
  --
  * Код пользователя <<FK>>
  * Назначение
  * Хэш токена <<AK>>
  * Время выдачи
  * Срок действия
    Время использования
}
rooms ||--o{ bookings
users ||--o{ bookings
promos |o--o{ bookings
bookings ||--o{ booking_events
users |o--o{ booking_events
rooms |o--o{ promos
users |o--o{ promos
bookings ||--o{ service_orders
services ||--o{ service_orders
bookings ||--o{ housekeeping_tasks
rooms ||--o{ housekeeping_tasks
users ||--o{ sessions
users ||--o{ email_tokens
@enduml
