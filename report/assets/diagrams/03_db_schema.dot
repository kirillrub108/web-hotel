digraph schema {
  graph [rankdir=LR, dpi=150, nodesep=0.12, ranksep=0.45, fontname="Arial", bgcolor="white", splines=spline, newrank=true];
  node [shape=plaintext, fontname="Arial", fontsize=10];
  edge [color="#444444", arrowsize=0.7, dir=both, arrowtail=crow, arrowhead=tee];
  { rank=same; booking_events; service_orders; housekeeping_tasks; }
  booking_events -> service_orders [style=invis];
  service_orders -> housekeeping_tasks [style=invis];
  { rank=same; bookings; services; }
  bookings -> services [style=invis];
  { rank=same; promos; sessions; email_tokens; }
  promos -> sessions [style=invis];
  sessions -> email_tokens [style=invis];
  { rank=same; rooms; users; hotels; }
  rooms -> users [style=invis];
  users -> hotels [style=invis];
  hotels [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>hotels</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">tagline</TD><TD PORT="tagline" ALIGN="LEFT">varchar(200) NN</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD PORT="description" ALIGN="LEFT">text NN</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD PORT="address" ALIGN="LEFT">varchar(200) NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD PORT="phone" ALIGN="LEFT">varchar(40) NN</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD PORT="email" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">check_in_time</TD><TD PORT="check_in_time" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">check_out_time</TD><TD PORT="check_out_time" ALIGN="LEFT">varchar(10) NN</TD></TR></TABLE>>];
  rooms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>rooms</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD PORT="slug" ALIGN="LEFT">varchar(60) NN</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD PORT="name" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD PORT="description" ALIGN="LEFT">text NN</TD></TR><TR><TD ALIGN="LEFT">price_per_night</TD><TD PORT="price_per_night" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">capacity</TD><TD PORT="capacity" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">area</TD><TD PORT="area" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">amenities</TD><TD PORT="amenities" ALIGN="LEFT">json NN</TD></TR><TR><TD ALIGN="LEFT">image</TD><TD PORT="image" ALIGN="LEFT">varchar(200) NN</TD></TR><TR><TD ALIGN="LEFT">is_available</TD><TD PORT="is_available" ALIGN="LEFT">boolean NN</TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>users</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD PORT="email" ALIGN="LEFT">varchar(254) NN</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD PORT="password_hash" ALIGN="LEFT">varchar(200) NN</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD PORT="full_name" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD PORT="phone" ALIGN="LEFT">varchar(40)</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD PORT="role" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">crm_status</TD><TD PORT="crm_status" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">crm_note</TD><TD PORT="crm_note" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD PORT="is_active" ALIGN="LEFT">boolean NN</TD></TR><TR><TD ALIGN="LEFT">email_verified_at</TD><TD PORT="email_verified_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT">consent_at</TD><TD PORT="consent_at" ALIGN="LEFT">timestamptz NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR><TR><TD ALIGN="LEFT">last_login_at</TD><TD PORT="last_login_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
  bookings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>bookings</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">FK room_id</TD><TD PORT="room_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD><TD PORT="user_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">guest_name</TD><TD PORT="guest_name" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD PORT="phone" ALIGN="LEFT">varchar(40) NN</TD></TR><TR><TD ALIGN="LEFT">check_in</TD><TD PORT="check_in" ALIGN="LEFT">date NN</TD></TR><TR><TD ALIGN="LEFT">check_out</TD><TD PORT="check_out" ALIGN="LEFT">date NN</TD></TR><TR><TD ALIGN="LEFT">guests</TD><TD PORT="guests" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">comment</TD><TD PORT="comment" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD PORT="status" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">decided_by</TD><TD PORT="decided_by" ALIGN="LEFT">varchar(20)</TD></TR><TR><TD ALIGN="LEFT">reason_codes</TD><TD PORT="reason_codes" ALIGN="LEFT">varchar[](32) NN</TD></TR><TR><TD ALIGN="LEFT">reason_text</TD><TD PORT="reason_text" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">nights</TD><TD PORT="nights" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">price_per_night</TD><TD PORT="price_per_night" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">discount</TD><TD PORT="discount" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">total_price</TD><TD PORT="total_price" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">FK promo_id</TD><TD PORT="promo_id" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">cancelled_by</TD><TD PORT="cancelled_by" ALIGN="LEFT">varchar(20)</TD></TR><TR><TD ALIGN="LEFT">cancelled_at</TD><TD PORT="cancelled_at" ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR></TABLE>>];
  booking_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>booking_events</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD PORT="booking_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">from_status</TD><TD PORT="from_status" ALIGN="LEFT">varchar(20)</TD></TR><TR><TD ALIGN="LEFT">to_status</TD><TD PORT="to_status" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">actor</TD><TD PORT="actor" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">FK actor_user_id</TD><TD PORT="actor_user_id" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">reason_codes</TD><TD PORT="reason_codes" ALIGN="LEFT">varchar[](32) NN</TD></TR><TR><TD ALIGN="LEFT">reason_text</TD><TD PORT="reason_text" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR></TABLE>>];
  promos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>promos</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD PORT="code" ALIGN="LEFT">varchar(32) NN</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD PORT="title" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD PORT="description" ALIGN="LEFT">text NN</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD PORT="kind" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">value</TD><TD PORT="value" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">valid_from</TD><TD PORT="valid_from" ALIGN="LEFT">date NN</TD></TR><TR><TD ALIGN="LEFT">valid_to</TD><TD PORT="valid_to" ALIGN="LEFT">date NN</TD></TR><TR><TD ALIGN="LEFT">min_nights</TD><TD PORT="min_nights" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">FK room_id</TD><TD PORT="room_id" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD><TD PORT="user_id" ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD PORT="is_active" ALIGN="LEFT">boolean NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR></TABLE>>];
  services [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>services</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD PORT="slug" ALIGN="LEFT">varchar(60) NN</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD PORT="title" ALIGN="LEFT">varchar(120) NN</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD PORT="description" ALIGN="LEFT">text NN</TD></TR><TR><TD ALIGN="LEFT">category</TD><TD PORT="category" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">price</TD><TD PORT="price" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">unit</TD><TD PORT="unit" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD PORT="is_active" ALIGN="LEFT">boolean NN</TD></TR><TR><TD ALIGN="LEFT">sort_order</TD><TD PORT="sort_order" ALIGN="LEFT">integer NN</TD></TR></TABLE>>];
  service_orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>service_orders</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD PORT="booking_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">FK service_id</TD><TD PORT="service_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD PORT="quantity" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">unit_price</TD><TD PORT="unit_price" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">total</TD><TD PORT="total" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">scheduled_at</TD><TD PORT="scheduled_at" ALIGN="LEFT">timestamptz NN</TD></TR><TR><TD ALIGN="LEFT">comment</TD><TD PORT="comment" ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD PORT="status" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR></TABLE>>];
  housekeeping_tasks [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>housekeeping_tasks</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">FK booking_id</TD><TD PORT="booking_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">FK room_id</TD><TD PORT="room_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">date</TD><TD PORT="date" ALIGN="LEFT">date NN</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD PORT="kind" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">slot</TD><TD PORT="slot" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD PORT="status" ALIGN="LEFT">varchar(10) NN</TD></TR><TR><TD ALIGN="LEFT">done_at</TD><TD PORT="done_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
  sessions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>sessions</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD><TD PORT="user_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD PORT="token_hash" ALIGN="LEFT">varchar(64) NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD PORT="expires_at" ALIGN="LEFT">timestamptz NN</TD></TR></TABLE>>];
  email_tokens [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>email_tokens</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD><TD PORT="user_id" ALIGN="LEFT">integer NN</TD></TR><TR><TD ALIGN="LEFT">purpose</TD><TD PORT="purpose" ALIGN="LEFT">varchar(20) NN</TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD PORT="token_hash" ALIGN="LEFT">varchar(64) NN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at" ALIGN="LEFT">timestamptz NN</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD PORT="expires_at" ALIGN="LEFT">timestamptz NN</TD></TR><TR><TD ALIGN="LEFT">used_at</TD><TD PORT="used_at" ALIGN="LEFT">timestamptz</TD></TR></TABLE>>];
  bookings:room_id:e -> rooms:id:w;
  bookings:user_id:e -> users:id:w;
  bookings:promo_id:e -> promos:id:w;
  booking_events:booking_id:e -> bookings:id:w;
  booking_events:actor_user_id:e -> users:id:w;
  promos:room_id:e -> rooms:id:w;
  promos:user_id:e -> users:id:w;
  service_orders:booking_id:e -> bookings:id:w;
  service_orders:service_id:e -> services:id:w;
  housekeeping_tasks:booking_id:e -> bookings:id:w;
  housekeeping_tasks:room_id:e -> rooms:id:w;
  sessions:user_id:e -> users:id:w;
  email_tokens:user_id:e -> users:id:w;
}
