  usecase "Просмотр каталога\nномеров" as UC2
  usecase "Просмотр карточки\nномера" as UC3
  usecase "Расчёт стоимости\nпроживания" as UC4
  usecase "Просмотр каталога\nуслуг" as UC5
  usecase "Просмотр контактов\nи политики обработки ПДн" as UC6
  usecase "Регистрация" as UC7
  usecase "Подтверждение\nэлектронной почты" as UC8
