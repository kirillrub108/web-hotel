@startuml
!include _style.iuml
left to right direction
actor "Администратор" as A
rectangle "Web-приложение гостиницы" {
  usecase "Просмотр заявок\nна бронирование" as UC1
  usecase "Просмотр брони\nи журнала событий" as UC2
  usecase "Подтверждение\nзаявки" as UC3
  usecase "Отклонение\nзаявки" as UC4
  usecase "Отмена брони" as UC5
  usecase "Ведение клиентской базы\n(CRM-статус, заметка)" as UC6
  usecase "Управление акциями\nи промокодами" as UC7
  usecase "Редактирование\nномеров" as UC8
  usecase "Управление каталогом\nуслуг" as UC9
  usecase "Обработка заказов\nуслуг" as UC10
  usecase "Ведение графика\nуборки" as UC11
}
A -- UC1
A -- UC6
A -- UC7
A -- UC8
A -- UC9
A -- UC10
A -- UC11
UC1 <.. UC2 : <<extend>>
UC2 <.. UC3 : <<extend>>
UC2 <.. UC4 : <<extend>>
UC2 <.. UC5 : <<extend>>
@enduml
