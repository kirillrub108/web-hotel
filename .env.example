# Файл не обязателен: docker-compose.yml подставляет значения по умолчанию.
# Скопируйте в .env и поменяйте то, что нужно.

# База данных
POSTGRES_USER=kivana
POSTGRES_PASSWORD=kivana
POSTGRES_DB=kivana

# Адрес сайта: от него строятся ссылки в письмах.
APP_BASE_URL=http://localhost:3000

# Почта. MAIL_BACKEND: resend — отправка через Resend; console — письма и ссылки в docker compose logs backend.
# Пустой MAIL_BACKEND: resend, если задан RESEND_API_KEY, иначе console.
MAIL_BACKEND=
# Ключ API Resend (https://resend.com/api-keys). Без ключа всё работает, письма видны в логах.
RESEND_API_KEY=
# Отправитель писем; домен должен быть подтверждён в Resend.
MAIL_FROM="Kivana <no-reply@kivana.ru>"

# Администратор, которого сид создаёт при первом запуске. Пароль существующего пользователя сид не меняет.
ADMIN_EMAIL=admin@kivana.ru
# Должен проходить политику паролей, иначе backend не запустится. Смените его на своём сервере.
ADMIN_PASSWORD="tidy copper lantern orbit"

# Минимальная длина пароля (NIST SP 800-63B: от 15 символов, если пароль — единственный фактор входа).
PASSWORD_MIN_LENGTH=15
# Срок жизни сессии гостя, дней.
SESSION_TTL_GUEST_DAYS=14
# Срок жизни сессии администратора, часов.
SESSION_TTL_ADMIN_HOURS=12
# true, когда сайт открывается по HTTPS: cookie сессии уйдёт только по защищённому соединению.
COOKIE_SECURE=false

# Бронирование
# Часовой пояс отеля: по нему считаются «сегодня», просрочка заявок и дедлайн отмены.
HOTEL_TZ=Europe/Moscow
# Гость отменяет подтверждённую бронь онлайн не позже чем за столько часов до заезда (дата + время заезда отеля).
FREE_CANCEL_HOURS=48
# Автоподтверждение: длиннее стольких ночей — ручной разбор (для VIP не действует).
AUTO_CONFIRM_MAX_NIGHTS=7
# Автоподтверждение: сумма больше этой, а у клиента ещё не было проживаний, — ручной разбор (для VIP не действует).
AUTO_CONFIRM_MAX_TOTAL=60000
# Автоподтверждение: заезд дальше стольких дней — ручной разбор (для VIP не действует).
AUTO_CONFIRM_MAX_LEAD_DAYS=180
# Самая длинная бронь, ночей.
MAX_STAY_NIGHTS=30
# На сколько дней вперёд можно забронировать.
MAX_LEAD_DAYS=365
# Сколько заявок на рассмотрении может быть у одного клиента одновременно.
MAX_PENDING_PER_CLIENT=3
# Кому писать о заявках на ручном разборе. Пусто — не писать.
ADMIN_NOTIFY_EMAIL=

# Опрос файлов в dev-сервере Nuxt. Нужен на Windows; на Linux и macOS можно выключить.
WATCH_POLLING=true
