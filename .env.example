# Файл не обязателен: docker-compose.yml подставляет значения по умолчанию.
# Скопируйте в .env и поменяйте то, что нужно.

# База данных
POSTGRES_USER=kivana
POSTGRES_PASSWORD=kivana
POSTGRES_DB=kivana

# Админка /admin. Пока ADMIN_PASSWORD пуст, вход отключён.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Ключ подписи сессии. Пустой — генерируется при старте, и вход сбрасывается при каждом перезапуске backend.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# true, когда сайт открывается по HTTPS: cookie сессии уйдёт только по защищённому соединению.
COOKIE_SECURE=false

# Опрос файлов в dev-сервере Nuxt. Нужен на Windows; на Linux и macOS можно выключить.
WATCH_POLLING=true
